{
  "name": "@grida/www-workspace",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings www",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "turbo": "2.11.11"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.5.2"
}
